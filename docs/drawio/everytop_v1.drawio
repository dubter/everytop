        <mxCell id="yH6e-yZAIVgWodAo-IZD-171" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Инфраструктура&lt;/h1&gt;&lt;p&gt;1) О&lt;span style=&quot;background-color: initial;&quot;&gt;ркестрация контейнеров:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;K8S&lt;/span&gt;&lt;/p&gt;&lt;p&gt;2) Л&lt;span style=&quot;background-color: initial;&quot;&gt;оги:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;ELK&lt;/span&gt;&lt;/p&gt;&lt;p&gt;3) М&lt;span style=&quot;background-color: initial;&quot;&gt;етрики:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Prometheus, Grafana, Alertmanager&lt;/span&gt;&lt;/p&gt;&lt;p&gt;4) Т&lt;span style=&quot;background-color: initial;&quot;&gt;рейсы:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Jaeger&lt;/span&gt;&lt;/p&gt;&lt;p&gt;5)&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;CI/CD:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;github actions&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;6) Cloud: Yandex Cloud&lt;/span&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
